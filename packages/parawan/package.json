{
  "name": "parawan",
  "version": "0.29.14",
  "description": "Parawan to nazwa marki paczki anonimizator: ten sam silnik, te same eksporty, polecenie parawan. Lokalna redakcja polskich danych osobowych (PII): ponad 20 typów, m.in. PESEL, NIP, REGON, IBAN, dowód (z walidacją sum kontrolnych), e-mail, telefon, adres, imię i nazwisko. Bez zależności, działa w Node, Deno, Bun i przeglądarce.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./ner": {
      "types": "./ner.d.ts",
      "import": "./ner.js"
    },
    "./ner-postprocess": {
      "types": "./ner-postprocess.d.ts",
      "import": "./ner-postprocess.js"
    },
    "./llm": {
      "types": "./llm.d.ts",
      "import": "./llm.js"
    }
  },
  "bin": {
    "parawan": "bin/parawan.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "bin",
    "NOTICE"
  ],
  "dependencies": {
    "anonimizator": "0.29.14"
  },
  "keywords": [
    "parawan",
    "anonimizator",
    "pii",
    "rodo",
    "gdpr",
    "anonimizacja",
    "pesel",
    "nip",
    "polish",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karolpolikarp/parawan.git",
    "directory": "packages/parawan"
  },
  "homepage": "https://parawan.karolwilczynski.com",
  "engines": {
    "node": ">=18.19"
  }
}
