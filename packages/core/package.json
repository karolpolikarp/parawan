{
  "name": "anonimizator",
  "version": "0.29.13",
  "description": "Lokalna redakcja polskich danych osobowych (PII): ponad 20 typów, m.in. PESEL, NIP, REGON, IBAN, dowód (z walidacją sum kontrolnych), e-mail, telefon, adres, imię i nazwisko. Bez zależności, działa w Node, Deno, Bun i przeglądarce.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ner": {
      "types": "./dist/ner-client.d.ts",
      "import": "./dist/ner-client.js"
    },
    "./ner-postprocess": {
      "types": "./dist/ner-postprocess.d.ts",
      "import": "./dist/ner-postprocess.js"
    },
    "./llm": {
      "types": "./dist/llm-client.d.ts",
      "import": "./dist/llm-client.js"
    }
  },
  "bin": {
    "anonimizator": "bin/anonimizator.js"
  },
  "files": [
    "dist",
    "bin",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "pii",
    "rodo",
    "gdpr",
    "anonimizacja",
    "anonymization",
    "redaction",
    "pesel",
    "nip",
    "regon",
    "iban",
    "polish",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karolpolikarp/parawan.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
