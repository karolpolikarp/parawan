  "os-o-24": "Sąd wysłuchał Anny Wiśniewskiej na rozprawie zdalnej.",
  "os-o-25": "Zarzuty postawiono Piotrowi Zielińskiemu.",
  "os-o-26": "Nagrodę wręczono Magdalenie Woźniak.",
  "os-o-27": "u Szymańskiego w biurze zostawiłem parasol",
  "os-o-28": "pytałem Lewandowskiego, ale nie odpisał",
  "os-o-29": "wczoraj widziałem Dąbrowskiego w urzędzie",
  "os-o-30": "Krawczykowi nikt nie uwierzył.",
  "os-o-31": "Dokumenty od Grabowskiej dotarły pocztą.",
  "os-o-32": "Decyzję wysłano do Jankowskich.",
  "os-o-33": "Na ulicy spotkałem wczoraj Jana Kowalskiego.",
  "os-o-34": "Jan
Wiśniewski złożył wniosek do urzędu.",
  "os-o-35": "z powództwa Pawła Kowalskiego przeciwko Agacie Nowak, z udziałem Jerzego Nowaka i Henrykiem Lisem",
  "os-p-01": "Pozwany Jan Kowalski nie stawił się na rozprawie.",
  "os-p-02": "Powódka Anna Nowak wniosła o zasądzenie kosztów.",
  "os-p-03": "Świadek Piotr Wiśniewski zeznał, że widział zdarzenie.",
  "os-p-04": "Umowę podpisała Katarzyna Zielińska w obecności notariusza.",
  "os-p-05": "Wniosek złożył Tomasz Szymański dnia 12 marca.",
  "os-p-06": "Magdalena Woźniak została powołana do zarządu.",
  "os-p-07": "Krzysztof Kaczmarek prowadzi warsztat przy rynku.",
  "os-p-08": "Na spotkanie przyszedł Marek Mazur z dokumentami.",
  "os-p-09": "Ewa Lewandowska odebrała przesyłkę osobiście.",
  "os-p-10": "hej, pisze do was Jakub Dąbrowski, mam pytanie o umowę",
  "os-p-11": "imię i nazwisko: jan kowalski",
  "os-p-12": "od anna nowak dostałem pismo",
  "os-p-13": "pełnomocnik: anna kowalska-nowak",
  "os-p-14": "Anna Kowalska wygrała sprawę w drugiej instancji.",
  "os-p-15": "Agnieszka Wiśniewska złożyła reklamację w sklepie.",
  "os-p-16": "Nowa księgowa to Joanna Zielińska.",
  "os-p-17": "Anna i Jan Kowalscy kupili mieszkanie na osiedlu.",
  "os-p-18": "Państwo Nowakowie wynajmują lokal od miasta.",
  "os-p-19": "Maria Nowak-Kowalska reprezentuje spółkę.",
  "os-p-20": "Pełnomocnikiem jest Karolina Zielińska-Wójcik.",
  "os-p-21": "Pismo podpisała Hanna Kowalczyk-Nowak.",
  "os-p-22": "Nazywam się Robert Malinowski i piszę w sprawie faktury.",
  "os-p-23": "Mam na imię Weronika, nazwisko Sobczak.",
  "os-p-24": "Pan Wiśniewski nie odpowiada na wezwania.",
  "os-p-25": "Proszę przekazać dokumenty pani Kowalskiej.",
  "os-p-26": "Imię i nazwisko: Adrian Borkowski.",
  "os-p-27": "nazywam się pAMELA nOWAK i czekam na odpowiedź.",
  "os-p-28": "Nazywam się PAMELA NOWAK, proszę o kontakt telefoniczny.",
  "os-p-29": "mam na imię PAMELA i dzwonię w sprawie faktury.",
  "os-p-30": "Imię: pamela
Nazwisko: nowak",
  "os-p-31": "PAMELA NOWAK złożyła wniosek w urzędzie miasta.",
  "os-p-32": "W składzie SSO JAN KOWALSKI wydał wyrok.",
  "os-p-33": "Rozmawiałem z PANEM MARKIEM WIŚNIEWSKIM osobiście.",
  "os-p-34": "POZWANY JAN KOWALSKI nie stawił się na rozprawie.",
  "os-p-35": "Wezwanie otrzymał PAN KOWALSKI dnia wczorajszego.",
  "os-p-36": "2024-03-01	Jan Kowalski	Warszawa	1250,00",
  "os-p-37": "Wystawił: Marek Dąbrowski     Odebrał: Ewa Kamińska",
  "os-p-38": "ORLEN S.A. Jan Kowalski — pełnomocnik spółki.",
  "os-p-39": "Sz. P. Andrzej Górski — odpowiedź na pismo.",
  "os-p-40": "Pełnomocnik: mec. Ł. Baran przedłożył pełnomocnictwo.",
  "os-p-41": "Sporządził Jan
Kowalski, dnia 3 marca.",
  "os-p-42": "Lista obecności:
Wilk Bartosz
Sowa Przemysław
Pawlak Wiesław",
  "os-p-43": "Przewodniczący: SSO J.M. Wilk
Sędziowie: SO A.K. Sowa, SO T.J. Mazur (spr.)",
  "os-p-44": "Wykonawca: P.H.U. Wilk Tomasz Wilk, NIP w załączeniu.",
  "os-p-45": "Wczoraj Kowalski przyszedł do biura. Sąsiad Wiśniewski zeznał, że nic nie słyszał.",
  "os-p-46": "Sprawę Kowalewicza przekazano do sądu, a Pan Kluczyk złożył wniosek.",
  "os-p-47": "Pani Minister Anna Nowak przemówiła.",
  "os-p-48": "Pomógł im Jan Kowalski w przeprowadzce.",
  "os-p-49": "Wnioskodawca: Kazimierz Dolny",
  "os-p-50": "Sąd przesłuchał św. Annę Gzowską. św. Kowalski zeznał, że nic nie widział.",
  "os-p-51": "Kierownik Zespołu Kowalski zatwierdził urlop. Reakcja Wiśniewskiego na wezwanie była natychmiastowa.",
  "os-p-52": "Konflikt na linii Nowak – Zieliński trwał od lat. Kierownik linii Wójcik polecił wyłączenie zasilania.",
  "os-p-53": "Na ul. Długiej lek. Anna Nowak udzieliła pomocy. W parku lek. Jan Kowalski reanimował poszkodowanego.",
  "os-p-54": "NA ULICY JAN KOWALSKI ZOSTAŁ POTRĄCONY. KIEROWNIK PLACÓWKI JOLANTA PYREK.",
  "os-p-55": "Mimo wezwania św. Tomasz Gzik nie stawił się. Pożar kościoła widział św. Kowalski.",
  "os-p-56": "Na rozprawie świadek Krzaczyk potwierdził, że Kluczyk był obecny. Pełnomocnik Placka wniósł o oddalenie powództwa.",
  "os-p-57": "Pod wskazanym adresem zamieszkuje Jarosław Wilk z konkubiną.",
  "os-p-58": "Sąd zasądził od uczestnika Kazimierza Dolnego koszty.",
  "os-p-59": "Wniosek złożyła Pasko-Gzowska. Szanowna Pani Dyrektor Szkoły Kowalska, uprzejmie informuję.",
  "os-p-60": "Na ulicy Jan Kowalski zasłabł. W parku Anna Nowak spacerowała z psem.",
  "os-p-61": "Badanie wykonał lek. Kluczyk. Mieczyk przebywa na zwolnieniu lekarskim.",
  "os-p-62": "W kościele św. Anny Jan Bednarz zagra koncert kolęd. W kościele przesłuchano św. Annę Gzowską.",
  "os-p-63": "Pacjent Tadeusz Nowacki trafił na SOR. Objawy Nowackiego nasiliły się w nocy. Mistrz linii Kowalskiego wydał polecenie.",
  "os-p-64": "Do: Wiśniewska, Ewa; Sowa, Jakub
Lista obecności:
Kowalska Anna Maria
Nowak Jan Piotr",
